# Generate a local .env with: python3 scripts/init-env.py
POSTGRES_PASSWORD=
JWT_SECRET=
HTTP_BIND=127.0.0.1
HTTP_PORT=8088
# Inclusive game-size range, shared by game and matchmaking services.
MIN_PLAYERS=2
MAX_PLAYERS=15
# Keep checksums enabled while allowing fallback if the official proxy is blocked.
GOPROXY=https://proxy.golang.org|https://goproxy.cn|direct
# Required only for the optional Telegram bot profile.
BOT_TELEGRAM__BOT_TOKEN=
# Optional existing HTTP/SOCKS proxy reachable from Docker, for Telegram access.
BOT_HTTPS_PROXY=
